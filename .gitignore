# Editor and OS noise
.DS_Store
*~
*.swp
.vscode/
.idea/

# Scratch space
*.log
*.tmp
downloads/
.cache/

# Wallpaper images are personal and not shared; the directory is tracked so
# the gnome module has somewhere to look.
assets/wallpaper/*
!assets/wallpaper/.gitkeep

# Runtime backups written by the locale and dns modules
.dns-backup
.locale-backup
