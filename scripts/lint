#!/usr/bin/env bash
# scripts/lint - static analysis: shellcheck + shfmt (P10.2).
#
# Scope: lib/, modules/, setup (the shipped code). The test files under tests/
# are intentionally excluded: they contain deliberate-bad fixtures (a fake
# sudo that must not escalate, a module with a broken list) that static analysis
# would flag by design.
#
# Tools: tools/shellcheck and tools/shfmt (installed by scripts/install-tools.sh).
# shellcheck reads .shellcheckrc from the repo root automatically. shfmt is
# pinned to 4-space indent (-i 4), matching the project style.
#
# Usage: bash scripts/lint   (or: make lint)
# Exits non-zero if any check fails.

set -euo pipefail

_this="${BASH_SOURCE[0]}"
_this="$(readlink -f -- "$_this" 2>/dev/null || printf '%s' "$_this")"
ROOT="$(cd "$(dirname "$_this")/.." && pwd)"

SHELLCHECK="$ROOT/tools/shellcheck"
SHFMT="$ROOT/tools/shfmt"

if [[ ! -x "$SHELLCHECK" ]]; then
    printf 'shellcheck not found at %s\n' "$SHELLCHECK" >&2
    printf 'run: bash scripts/install-tools.sh\n' >&2
    exit 1
fi
if [[ ! -x "$SHFMT" ]]; then
    printf 'shfmt not found at %s\n' "$SHFMT" >&2
    printf 'run: bash scripts/install-tools.sh\n' >&2
    exit 1
fi

TARGETS=(
    "$ROOT"/lib/*.sh
    "$ROOT"/lib/pkg/*.sh
    "$ROOT"/modules/*/*.sh
    "$ROOT"/setup
)

fail=0

printf '== shellcheck ==\n'
if ! "$SHELLCHECK" --severity=warning "${TARGETS[@]}"; then
    fail=1
fi

printf '== shfmt ==\n'
if ! "$SHFMT" -i 4 -d "${TARGETS[@]}"; then
    fail=1
fi

if (( fail )); then
    printf 'lint: FAILED\n' >&2
    exit 1
fi
printf 'lint: OK\n'
