#!/bin/bash

################################################################################
# Modular Linux Postinstall Setup Script
# Parses the CLI, runs the fixed module order from modules/, and fails fast.
################################################################################

# Version
VERSION="v2.1.1"

SETUP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SETUP_DIR/lib/common.sh"

# Check if the script is run as root
if [ "$EUID" -eq 0 ]; then
    echo "This script should not be run as root. Please run it as a regular user."
    exit 1
fi

# Print usage/help
usage() {
    echo "Usage: $0 [--dry-run] [command]"
    echo
    echo "Commands:"
    echo "  install      Run all setup steps (recommended; same as no arguments)"
    echo "  terminal     Select the default shell and configure Atuin and Starship for it"
    echo "  aliases      Set the project aliases in shell configuration files"
    echo "  packages     Install system packages, Flatpaks, and vendor applications"
    echo "  language     Set system language (English/Arabic)"
    echo "  fonts        Install user fonts from additions/fonts"
    echo "  dev          Set up the development environment"
    echo "  gnome        Run the GNOME desktop configuration steps"
    echo "  shortcuts    Add custom GNOME keyboard shortcuts"
    echo "  favorites    Set favorite apps in the GNOME dock"
    echo "  extensions   Open recommended GNOME extensions in your browser"
    echo "  help         Show this help message"
    echo "  version      Show version"
    echo
    echo "Options:"
    echo "  --dry-run          Print the commands that would run, without running them"
    echo "  -h, --help         Show this help message"
    echo "  -v, --version      Show version"
}

run_step() {
    local script="$1"
    local step_name="$2"
    bash "$script"
    local rc=$?
    if [ $rc -ne 0 ]; then
        echo "Error: Failed at step '$step_name' ($script) with exit code $rc" >&2
        exit $rc
    fi
}

# Remove sudo credentials only when this run actually created them: the
# marker exists only after a successful interactive sudo -v, so a credential
# timestamp that was already valid before the run is never cleared. Runs on
# both success and failure; sudo -k never prompts.
cleanup_sudo() {
    if [ -n "${SETUP_SUDO_MARKER:-}" ] && [ -f "$SETUP_SUDO_MARKER" ]; then
        sudo -k >/dev/null 2>&1 || true
        rm -f "$SETUP_SUDO_MARKER"
    fi
}

# GNOME-only steps, in order
run_gnome_steps() {
    run_step "$SETUP_DIR/modules/set_wallpaper.sh" "set_wallpaper"
    run_step "$SETUP_DIR/modules/gnome_themes.sh" "gnome_themes"
    run_step "$SETUP_DIR/modules/icons_and_cursors.sh" "icons_and_cursors"
    run_step "$SETUP_DIR/modules/set_favorite_apps.sh" "set_favorite_apps"
    run_step "$SETUP_DIR/modules/add_custom_shortcut.sh" "add_custom_shortcut"
    run_step "$SETUP_DIR/modules/gnome_extensions.sh" "gnome_extensions"
}

# Full setup: normal steps always, GNOME steps only on a GNOME desktop
cmd_install() {
    local de
    de=$(desktop_environment)
    echo "Desktop environment: $de"

    run_step "$SETUP_DIR/modules/install_apps.sh" "packages"
    run_step "$SETUP_DIR/modules/change_language.sh" "language"
    run_step "$SETUP_DIR/modules/install_fonts.sh" "fonts"
    run_step "$SETUP_DIR/modules/set_aliases.sh" "aliases"
    run_step "$SETUP_DIR/modules/terminal_themes.sh" "terminal_themes"
    run_step "$SETUP_DIR/modules/dev.sh" "dev"

    if [ "$de" = "gnome" ]; then
        run_gnome_steps
    else
        echo "Skipping GNOME steps (desktop: $de)."
    fi
}

# Main execution
main() {
    local cmd="" cmd_seen=0 arg

    # Parse every argument before running any setup step.
    # No arguments and 'install' both run the full setup.
    # An empty-string argument stays invalid.
    for arg in "$@"; do
        case "$arg" in
            --dry-run)
                export SETUP_DRY_RUN=1
                ;;
            help|-h|--help)
                usage
                exit 0
                ;;
            version|-v|--version)
                echo "setup $VERSION"
                exit 0
                ;;
            -*)
                echo "Error: Unknown option '$arg'." >&2
                echo "For more information, run '$0 help'." >&2
                exit 1
                ;;
            *)
                if [ "$cmd_seen" -eq 1 ]; then
                    echo "Error: Unexpected argument '$arg'." >&2
                    echo "For more information, run '$0 help'." >&2
                    exit 1
                fi
                cmd="$arg"
                cmd_seen=1
                ;;
        esac
    done

    # After parsing only (help/version/invalid exits never reach sudo): export
    # the credential marker and arm cleanup. Dry-run never authenticates, so
    # it never needs a marker either.
    if [ "${SETUP_DRY_RUN:-0}" != "1" ]; then
        SETUP_SUDO_MARKER="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/setup-sudo-auth.$$"
        export SETUP_SUDO_MARKER
        trap cleanup_sudo EXIT
    fi

    if [ "$cmd_seen" -eq 0 ]; then
        cmd_install
    else
        case "$cmd" in
            install)
                cmd_install
                ;;
            packages)
                run_step "$SETUP_DIR/modules/install_apps.sh" "packages"
                ;;
            language)
                run_step "$SETUP_DIR/modules/change_language.sh" "language"
                ;;
            fonts)
                run_step "$SETUP_DIR/modules/install_fonts.sh" "fonts"
                ;;
            aliases)
                run_step "$SETUP_DIR/modules/set_aliases.sh" "aliases"
                ;;
            terminal)
                run_step "$SETUP_DIR/modules/terminal_themes.sh" "terminal_themes"
                ;;
            dev)
                run_step "$SETUP_DIR/modules/dev.sh" "dev"
                ;;
            gnome)
                run_gnome_steps
                ;;
            shortcuts)
                run_step "$SETUP_DIR/modules/add_custom_shortcut.sh" "add_custom_shortcut"
                ;;
            favorites)
                run_step "$SETUP_DIR/modules/set_favorite_apps.sh" "set_favorite_apps"
                ;;
            extensions)
                run_step "$SETUP_DIR/modules/gnome_extensions.sh" "gnome_extensions"
                ;;
            *)
                echo "Error: Invalid command '$cmd'." >&2
                echo "For more information, run '$0 help'." >&2
                exit 1
                ;;
        esac
    fi

    echo -e "Installation complete.\n"
    exit 0
}

# Run the main function
main "$@"
