#!/usr/bin/env bash
# setup - personal post-install script.
#
#   ./setup                     install packages, then run every module
#   ./setup install             same
#   ./setup install terminal    install packages, then run only these modules
#   ./setup packages            install packages and Flatpaks only
#   ./setup modules             run every module, install no packages
#   ./setup list                list available modules
#   ./setup help                this text
#
# Options:
#   --dry-run    print every command instead of running it; change nothing
#   -h --help    this text
#
# Order of work: detect the distro, install config/packages.txt (plus
# config/packages-<family>.txt when present) and config/flatpak.txt, then run
# each module named on the command line, or the ones in config/modules.txt.
#
# A failing module is reported and the rest still run; the exit status is 1 if
# any step failed.

set -euo pipefail

FS_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export FS_ROOT

source "$FS_ROOT/lib/common.sh"
source "$FS_ROOT/lib/packages.sh"
source "$FS_ROOT/lib/config.sh"
source "$FS_ROOT/lib/modules.sh"

_tmpdirs=()
cleanup() {
    local d
    for d in "${_tmpdirs[@]+"${_tmpdirs[@]}"}"; do
        rm -rf -- "$d"
    done
}
trap cleanup EXIT

usage() {
    sed -n '2,14p' "$0" | sed 's/^#\{1,\} \{0,1\}//'
}

do_packages() {
    install_packages $(package_files)
    if [[ -f "$FS_ROOT/config/flatpak.txt" ]]; then
        install_flatpaks "$FS_ROOT/config/flatpak.txt"
    fi
}

do_modules() {
    if (($# > 0)); then
        run_modules "$@"
        return
    fi
    local -a ids=()
    mapfile -t ids < <(default_modules)
    ((${#ids[@]} > 0)) || die "no modules configured in config/modules.txt"
    run_modules "${ids[@]}"
}

main() {
    local cmd="all"
    local -a ids=()

    while (($# > 0)); do
        case "$1" in
        -h | --help)
            usage
            return 0
            ;;
        --dry-run)
            FS_DRY_RUN=1
            ;;
        -*)
            usage >&2
            die "unknown option: $1"
            ;;
        *)
            cmd="$1"
            shift
            ids+=("$@")
            break
            ;;
        esac
        shift
    done

    case "$cmd" in
    list)
        ((${#ids[@]} == 0)) || die "list takes no module names"
        list_modules
        return 0
        ;;
    help | "")
        ((${#ids[@]} == 0)) || die "help takes no arguments"
        usage
        return 0
        ;;
    install | all | modules)
        if ((${#ids[@]} > 0)); then
            validate_modules "${ids[@]}"
        fi
        ;;
    packages)
        ((${#ids[@]} == 0)) || die "packages takes no module names"
        ;;
    *)
        usage >&2
        die "unknown command: $cmd"
        ;;
    esac

    if ((FS_DRY_RUN)); then
        log_info "DRY RUN: nothing will be changed"
    fi
    detect_distro

    local rc=0
    case "$cmd" in
    install | all)
        do_packages || rc=1
        do_modules "${ids[@]+"${ids[@]}"}" || rc=1
        ;;
    packages)
        do_packages || rc=1
        ;;
    modules)
        do_modules "${ids[@]+"${ids[@]}"}" || rc=1
        ;;
    esac

    if ((rc == 0)); then
        log_info "done"
    else
        log_error "finished with errors (rc=$rc)"
    fi
    return "$rc"
}

main "$@"
