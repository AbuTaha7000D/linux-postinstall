#!/usr/bin/env bash
set -euo pipefail

_setup_check_tools() {
    local cmd
    for cmd in dirname; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            printf 'error: required tool %s not found in PATH\n' "$cmd" >&2
            exit 1
        fi
    done
}

_self="${BASH_SOURCE[0]}"
if [[ "$_self" != */* ]]; then
    if [[ -f "$PWD/$_self" ]]; then
        _self="$PWD/$_self"
    elif command -v -- "$_self" >/dev/null 2>&1; then
        _self="$(command -v -- "$_self")"
    fi
fi
if [[ -z "$_self" ]]; then
    printf 'error: cannot locate the setup script\n' >&2
    exit 1
fi

_setup_check_tools

if command -v readlink >/dev/null 2>&1; then
    _self="$(readlink -f -- "$_self" 2>/dev/null || printf '%s' "$_self")"
fi

_dir="$(cd -- "$(dirname -- "$_self")" && pwd)"
exec "$_dir/lib/bootstrap.sh" "$@"
